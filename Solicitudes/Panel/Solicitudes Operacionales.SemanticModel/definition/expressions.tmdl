expression query_workflow_solicitudes_todas = ```
let
    Query = "-- SOLICITUDES WORKFLOW: DATASET HISTORICO PARA TODAS LAS TIPOLOGIAS#(lf)-- Amazon Athena / Trino. Una fila por solicitud y propiedad del formulario.#(lf)-- Sin filtro fijo de periodo. Los indicadores deben contar DISTINCT id.#(lf)#(lf)WITH workflows AS (#(lf)    SELECT *#(lf)    FROM (#(lf)        SELECT#(lf)            w.*,#(lf)            ROW_NUMBER() OVER (#(lf)                PARTITION BY w.id#(lf)                ORDER BY w.dt DESC NULLS LAST#(lf)            ) AS rn#(lf)        FROM uss_datalake_stage.banner_oracle_workflow_eng_workflow AS w#(lf)    ) AS ranked#(lf)    WHERE rn = 1#(lf)),#(lf)definiciones AS (#(lf)    SELECT *#(lf)    FROM (#(lf)        SELECT#(lf)            p.*,#(lf)            ROW_NUMBER() OVER (#(lf)                PARTITION BY p.id#(lf)                ORDER BY p.version DESC NULLS LAST, p.dt DESC NULLS LAST#(lf)            ) AS rn#(lf)        FROM uss_datalake_stage.banner_oracle_workflow_process_definition AS p#(lf)    ) AS ranked#(lf)    WHERE rn = 1#(lf)),#(lf)propiedades AS (#(lf)    SELECT *#(lf)    FROM (#(lf)        SELECT#(lf)            v.*,#(lf)            ROW_NUMBER() OVER (#(lf)                PARTITION BY v.id, v.name, v.seq#(lf)                ORDER BY v.dt DESC NULLS LAST#(lf)            ) AS rn#(lf)        FROM uss_datalake_stage.banner_oracle_workflow_eng_properties_values AS v#(lf)    ) AS ranked#(lf)    WHERE rn = 1#(lf)),#(lf)base_larga AS (#(lf)    SELECT#(lf)        w.id,#(lf)        w.pd_id,#(lf)        w.name AS cabecera,#(lf)        w.current_state AS estado_actual,#(lf)        CASE#(lf)            WHEN LOWER(COALESCE(w.current_state, '')) LIKE '%cancel%' THEN 'CANCELADA'#(lf)            WHEN LOWER(COALESCE(w.current_state, '')) LIKE '%completed%'#(lf)              OR LOWER(COALESCE(w.current_state, '')) LIKE '%stopped%' THEN 'FINALIZADA'#(lf)            WHEN UPPER(COALESCE(w.running, '')) = 'Y' THEN 'EN CURSO'#(lf)            ELSE 'OTRO'#(lf)        END AS estado_operacional,#(lf)        w.start_date,#(lf)        w.stop_date,#(lf)        pd.name AS tipo_solicitud,#(lf)        CASE#(lf)            WHEN LOWER(COALESCE(pd.name, '')) LIKE '%reincorpor%' THEN 'Reincorporación'#(lf)            WHEN LOWER(COALESCE(pd.name, '')) LIKE '%cambio de nota%'#(lf)              OR LOWER(COALESCE(pd.name, '')) LIKE '%calific%' THEN 'Cambio de calificación'#(lf)            WHEN LOWER(COALESCE(pd.name, '')) LIKE '%continuidad%' THEN 'Continuidad de estudios'#(lf)            WHEN REGEXP_LIKE(#(lf)                REGEXP_REPLACE(#(lf)                    LOWER(COALESCE(pd.name, '')),#(lf)                    '[_-]+',#(lf)                    ' '#(lf)                ),#(lf)                'cambio( de)? carrera( sede)?'#(lf)            ) THEN 'Cambio de carrera/sede'#(lf)            WHEN LOWER(COALESCE(pd.name, '')) LIKE '%suspensi%'#(lf)              OR LOWER(COALESCE(pd.name, '')) LIKE '%suspension%' THEN 'Suspensión'#(lf)            WHEN LOWER(COALESCE(pd.name, '')) LIKE '%inscripcion especial%'#(lf)              OR LOWER(COALESCE(pd.name, '')) LIKE '%inscripción especial%' THEN 'Inscripción especial'#(lf)            WHEN LOWER(COALESCE(pd.name, '')) LIKE '%retiro%' THEN 'Retiro'#(lf)            WHEN LOWER(COALESCE(pd.name, '')) LIKE '%inscripci%extraordin%'#(lf)              OR LOWER(COALESCE(pd.name, '')) LIKE '%inscripcion extraordinaria%' THEN 'Inscripción extraordinaria'#(lf)            ELSE COALESCE(pd.name, 'Sin clasificación')#(lf)        END AS categoria_solicitud,#(lf)        w.last_state AS ultima_actividad,#(lf)        w.origin AS origen,#(lf)        w.running AS indicador_en_ejecucion,#(lf)        CAST(w.originating_user_id AS VARCHAR) AS usuario_origen_id,#(lf)        CAST(w.owner_role_id AS VARCHAR) AS rol_propietario_id,#(lf)        CAST(w.admin_role_id AS VARCHAR) AS rol_administrador_id,#(lf)        pv.name AS nombre_propiedad,#(lf)        pv.type AS tipo_propiedad,#(lf)        pv.seq AS secuencia_propiedad,#(lf)        pv.value AS valor_propiedad,#(lf)        pd.description AS descripcion_tipo_solicitud,#(lf)        pd.version AS version_workflow,#(lf)        CAST(w.dt AS VARCHAR) AS particion_workflow,#(lf)        CAST(pv.dt AS VARCHAR) AS particion_propiedad#(lf)    FROM workflows AS w#(lf)    LEFT JOIN definiciones AS pd#(lf)        ON w.pd_id = pd.id#(lf)    LEFT JOIN propiedades AS pv#(lf)        ON w.id = pv.id#(lf)),#(lf)enriquecida AS (#(lf)    SELECT#(lf)        b.*,#(lf)        MAX(#(lf)            CASE WHEN REGEXP_LIKE(#(lf)                LOWER(COALESCE(b.nombre_propiedad, '')),#(lf)                '(^|_)(periodo|periodo_adm|periodo_academico|periodo_consulta|term|term_code)($|_)'#(lf)            ) THEN b.valor_propiedad END#(lf)        ) OVER (PARTITION BY b.id) AS periodo_detectado,#(lf)        MAX(#(lf)            CASE WHEN REGEXP_LIKE(#(lf)                LOWER(COALESCE(b.nombre_propiedad, '')),#(lf)                '(^|_)(sede|campus|cod_sede|nombre_sede)($|_)'#(lf)            ) THEN b.valor_propiedad END#(lf)        ) OVER (PARTITION BY b.id) AS sede_detectada,#(lf)        MAX(#(lf)            CASE WHEN REGEXP_LIKE(#(lf)                LOWER(COALESCE(b.nombre_propiedad, '')),#(lf)                '(^|_)(nivel|nivel_academico|nivel_estudiante)($|_)'#(lf)            ) THEN b.valor_propiedad END#(lf)        ) OVER (PARTITION BY b.id) AS nivel_detectado,#(lf)        MAX(#(lf)            CASE WHEN REGEXP_LIKE(#(lf)                LOWER(COALESCE(b.nombre_propiedad, '')),#(lf)                '(^|_)(rut|rut_estudiante|rut_alumno|rutalumno)($|_)'#(lf)            ) THEN b.valor_propiedad END#(lf)        ) OVER (PARTITION BY b.id) AS rut_estudiante_detectado#(lf)    FROM base_larga AS b#(lf))#(lf)SELECT#(lf)    id,#(lf)    pd_id,#(lf)    cabecera,#(lf)    estado_actual,#(lf)    estado_operacional,#(lf)    start_date,#(lf)    stop_date,#(lf)    tipo_solicitud,#(lf)    categoria_solicitud,#(lf)    COALESCE(periodo_detectado, 'Sin periodo') AS periodo,#(lf)    COALESCE(sede_detectada, 'Sin sede') AS sede,#(lf)    COALESCE(nivel_detectado, 'Sin nivel') AS nivel,#(lf)    rut_estudiante_detectado AS rut_estudiante,#(lf)    ultima_actividad,#(lf)    origen,#(lf)    indicador_en_ejecucion,#(lf)    usuario_origen_id,#(lf)    rol_propietario_id,#(lf)    rol_administrador_id,#(lf)    nombre_propiedad,#(lf)    tipo_propiedad,#(lf)    secuencia_propiedad,#(lf)    valor_propiedad,#(lf)    descripcion_tipo_solicitud,#(lf)    version_workflow,#(lf)    particion_workflow,#(lf)    particion_propiedad#(lf)FROM enriquecida;#(lf)"
in
    Query
```

	lineageTag: 1e1329fb-dc0b-4ed1-be45-611b3441b912
	queryGroup: Queries

