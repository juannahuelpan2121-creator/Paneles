expression query_solicitudes_inscripcion =
		let
		    Query = "-- Reporte WF Solicitud Extraordinaria de Inscripcion de Asignaturas#(lf)-- Version Data Lake optimizada para Amazon Athena / Trino.#(lf)--#(lf)-- Mejoras principales:#(lf)--   1. ENG_PROPERTIES_VALUES se lee de forma agregada en vez de ejecutar#(lf)--      una subconsulta correlacionada por cada columna.#(lf)--   2. Los NRC solicitados se normalizan en filas y se enriquecen una sola vez.#(lf)--   3. SCBCRSE se resuelve con la version vigente al periodo de la seccion.#(lf)--   4. La limpieza de HTML usa expresiones regulares en lugar de decenas de REPLACE.#(lf)--#(lf)-- La consulta no fija periodo y carga el historico completo del workflow.#(lf)-- Para cambiar el tipo de workflow, modificar solamente el pd_id del CTE parametros.#(lf)#(lf)WITH parametros AS (#(lf)    SELECT CAST(19994978 AS BIGINT) AS pd_id#(lf)),#(lf)#(lf)workflow_base AS (#(lf)    SELECT#(lf)        wf.id,#(lf)        wf.pd_id,#(lf)        wf.name AS workflow_name,#(lf)        wf.current_state,#(lf)        wf.start_date,#(lf)        wf.stop_date,#(lf)        wf.running,#(lf)        wf.last_state,#(lf)        wf.originating_user_id,#(lf)        wf.originating_event_id,#(lf)        wf.originating_process_id,#(lf)        wf.owner_role_id,#(lf)        wf.admin_role_id,#(lf)        wf.requires_execution_plan#(lf)    FROM uss_datalake_stage.banner_oracle_workflow_eng_workflow AS wf#(lf)    CROSS JOIN parametros AS par#(lf)    WHERE wf.pd_id = par.pd_id#(lf)),#(lf)#(lf)propiedades_base AS (#(lf)    SELECT#(lf)        epv.id,#(lf)        epv.name,#(lf)        epv.value#(lf)    FROM uss_datalake_stage.banner_oracle_workflow_eng_properties_values AS epv#(lf)    INNER JOIN workflow_base AS wf#(lf)        ON wf.id = epv.id#(lf)    WHERE epv.name IN (#(lf)        'C_RUT', 'C_FULL_NAME', 'C_CARRERA', 'WF_ESTPROGRAMA',#(lf)        'C_EMAIL_ALUMNO', 'WF_NIVEL', 'WF_PERIODOADM',#(lf)        'WF_TIENERETENCION', 'C_SEDE', 'C_SECPLAN', 'WF_PGA',#(lf)        'WF_ASIGAPROBADAS', 'C_FECHA_SOLICITUD', 'C_PERIODO',#(lf)        'C_CODIGO_SALICITUD', 'WF_COMENTARIOEST',#(lf)        'WF_OPCNRC1', 'WF_OPCNRC2', 'WF_OPCNRC3', 'WF_OPCNRC4',#(lf)        'WF_OPCNRC5', 'WF_OPCNRC6', 'WF_OPCNRC7', 'WF_OPCNRC8',#(lf)        'WF_OPCNRC9', 'WF_OPCNRC10', 'WF_OPCNRC11', 'WF_OPCNRC12',#(lf)        'WF_RESPNRC1', 'WF_RESPNRC2', 'WF_RESPNRC3', 'WF_RESPNRC4',#(lf)        'WF_RESPNRC5', 'WF_RESPNRC6', 'WF_RESPNRC7', 'WF_RESPNRC8',#(lf)        'WF_RESPNRC9', 'WF_RESPNRC10', 'WF_RESPNRC11', 'WF_RESPNRC12',#(lf)        'WF_NRCS_SOLICITADOS', 'C_LISTADO_NRCS_RECHAZADOS', 'WF_MENSAJE'#(lf)    )#(lf)),#(lf)#(lf)propiedades AS (#(lf)    SELECT#(lf)        id,#(lf)        MAX(CASE WHEN name = 'C_RUT' THEN value END) AS rut_estudiante,#(lf)        MAX(CASE WHEN name = 'C_FULL_NAME' THEN value END) AS nombre_estudiante,#(lf)        MAX(CASE WHEN name = 'C_CARRERA' THEN value END) AS c_carrera,#(lf)        MAX(CASE WHEN name = 'WF_ESTPROGRAMA' THEN value END) AS estado_alumno,#(lf)        MAX(CASE WHEN name = 'C_EMAIL_ALUMNO' THEN value END) AS email_alumno,#(lf)        MAX(CASE WHEN name = 'WF_NIVEL' THEN value END) AS nivel,#(lf)        MAX(CASE WHEN name = 'WF_PERIODOADM' THEN value END) AS periodo_adm,#(lf)        MAX(CASE WHEN name = 'WF_TIENERETENCION' THEN value END) AS retencion,#(lf)        MAX(CASE WHEN name = 'C_SEDE' THEN value END) AS sede,#(lf)        MAX(CASE WHEN name = 'C_SECPLAN' THEN value END) AS secuencia_plan,#(lf)        MAX(CASE WHEN name = 'WF_PGA' THEN REPLACE(value, '.', ',') END) AS pga,#(lf)        ARRAY_JOIN(#(lf)            ARRAY_AGG(#(lf)                DISTINCT TRIM(REGEXP_REPLACE(value, '[\r\n\t]+', ' '))#(lf)            ) FILTER (WHERE name = 'WF_ASIGAPROBADAS'),#(lf)            ' | '#(lf)        ) AS asignaturas_aprobadas,#(lf)        MAX(CASE WHEN name = 'C_FECHA_SOLICITUD' THEN value END) AS fecha_solicitud,#(lf)        MAX(CASE WHEN name = 'C_PERIODO' THEN value END) AS periodo,#(lf)        MAX(CASE WHEN name = 'C_CODIGO_SALICITUD' THEN value END) AS c_codigo_solicitud,#(lf)        ARRAY_JOIN(#(lf)            ARRAY_AGG(#(lf)                DISTINCT TRIM(REGEXP_REPLACE(value, '[\r\n\t]+', ' '))#(lf)            ) FILTER (WHERE name = 'WF_COMENTARIOEST'),#(lf)            ' | '#(lf)        ) AS comentario,#(lf)        MAX(CASE WHEN name = 'WF_RESPNRC1' THEN value END) AS resp_nrc1,#(lf)        MAX(CASE WHEN name = 'WF_RESPNRC2' THEN value END) AS resp_nrc2,#(lf)        MAX(CASE WHEN name = 'WF_RESPNRC3' THEN value END) AS resp_nrc3,#(lf)        MAX(CASE WHEN name = 'WF_RESPNRC4' THEN value END) AS resp_nrc4,#(lf)        MAX(CASE WHEN name = 'WF_RESPNRC5' THEN value END) AS resp_nrc5,#(lf)        MAX(CASE WHEN name = 'WF_RESPNRC6' THEN value END) AS resp_nrc6,#(lf)        MAX(CASE WHEN name = 'WF_RESPNRC7' THEN value END) AS resp_nrc7,#(lf)        MAX(CASE WHEN name = 'WF_RESPNRC8' THEN value END) AS resp_nrc8,#(lf)        MAX(CASE WHEN name = 'WF_RESPNRC9' THEN value END) AS resp_nrc9,#(lf)        MAX(CASE WHEN name = 'WF_RESPNRC10' THEN value END) AS resp_nrc10,#(lf)        MAX(CASE WHEN name = 'WF_RESPNRC11' THEN value END) AS resp_nrc11,#(lf)        MAX(CASE WHEN name = 'WF_RESPNRC12' THEN value END) AS resp_nrc12,#(lf)        ARRAY_JOIN(#(lf)            ARRAY_AGG(#(lf)                DISTINCT TRIM(#(lf)                    REGEXP_REPLACE(#(lf)                        REGEXP_REPLACE(#(lf)                            REPLACE(#(lf)                                REPLACE(#(lf)                                    REPLACE(#(lf)                                        REPLACE(#(lf)                                            REPLACE(#(lf)                                                REPLACE(value, '&nbsp;', ' '),#(lf)                                                '&aacute;', 'á'#(lf)                                            ),#(lf)                                            '&eacute;', 'é'#(lf)                                        ),#(lf)                                        '&iacute;', 'í'#(lf)                                    ),#(lf)                                    '&oacute;', 'ó'#(lf)                                ),#(lf)                                '&uacute;', 'ú'#(lf)                            ),#(lf)                            '<[^>]*>',#(lf)                            ' '#(lf)                        ),#(lf)                        '\s+',#(lf)                        ' '#(lf)                    )#(lf)                )#(lf)            ) FILTER (WHERE name = 'WF_NRCS_SOLICITADOS'),#(lf)            ' | '#(lf)        ) AS nrcs_solicitados,#(lf)        ARRAY_JOIN(#(lf)            ARRAY_AGG(#(lf)                DISTINCT TRIM(#(lf)                    REGEXP_REPLACE(#(lf)                        REGEXP_REPLACE(#(lf)                            REPLACE(#(lf)                                REPLACE(#(lf)                                    REPLACE(#(lf)                                        REPLACE(#(lf)                                            REPLACE(#(lf)                                                REPLACE(value, '&nbsp;', ' '),#(lf)                                                '&aacute;', 'á'#(lf)                                            ),#(lf)                                            '&eacute;', 'é'#(lf)                                        ),#(lf)                                        '&iacute;', 'í'#(lf)                                    ),#(lf)                                    '&oacute;', 'ó'#(lf)                                ),#(lf)                                '&uacute;', 'ú'#(lf)                            ),#(lf)                            '<[^>]*>',#(lf)                            ' '#(lf)                        ),#(lf)                        '\s+',#(lf)                        ' '#(lf)                    )#(lf)                )#(lf)            ) FILTER (WHERE name = 'C_LISTADO_NRCS_RECHAZADOS'),#(lf)            ' | '#(lf)        ) AS nrcs_rechazado,#(lf)        MAX(CASE WHEN name = 'WF_MENSAJE' THEN value END) AS mensaje#(lf)    FROM propiedades_base#(lf)    GROUP BY id#(lf)),#(lf)#(lf)periodos_reporte AS (#(lf)    SELECT DISTINCT periodo#(lf)    FROM propiedades#(lf)    WHERE NULLIF(TRIM(periodo), '') IS NOT NULL#(lf)),#(lf)#(lf)nrc_solicitado AS (#(lf)    SELECT#(lf)        id,#(lf)        CAST(REGEXP_EXTRACT(name, '([0-9]+)$', 1) AS INTEGER) AS posicion,#(lf)        REGEXP_EXTRACT(TRIM(value), '([0-9]+)', 1) AS crn#(lf)    FROM propiedades_base#(lf)    WHERE REGEXP_LIKE(name, '^WF_OPCNRC([1-9]|1[0-2])$')#(lf)      AND NULLIF(TRIM(value), '') IS NOT NULL#(lf)),#(lf)#(lf)seccion_curso AS (#(lf)    SELECT#(lf)        s.ssbsect_term_code AS periodo,#(lf)        CAST(s.ssbsect_crn AS VARCHAR) AS crn,#(lf)        s.ssbsect_subj_code AS materia,#(lf)        s.ssbsect_crse_numb AS curso,#(lf)        c.scbcrse_title AS nombre_curso,#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY s.ssbsect_term_code, s.ssbsect_crn#(lf)            ORDER BY c.scbcrse_eff_term DESC#(lf)        ) AS rn#(lf)    FROM uss_datalake_stage.banner_oracle_saturn_ssbsect AS s#(lf)    INNER JOIN periodos_reporte AS pr#(lf)        ON pr.periodo = s.ssbsect_term_code#(lf)    LEFT JOIN uss_datalake_stage.banner_oracle_saturn_scbcrse AS c#(lf)        ON c.scbcrse_subj_code = s.ssbsect_subj_code#(lf)       AND c.scbcrse_crse_numb = s.ssbsect_crse_numb#(lf)       AND c.scbcrse_eff_term <= s.ssbsect_term_code#(lf)),#(lf)#(lf)nrc_detalle AS (#(lf)    SELECT#(lf)        n.id,#(lf)        n.posicion,#(lf)        CASE#(lf)            WHEN sc.crn IS NULL THEN NULL#(lf)            ELSE CONCAT(#(lf)                n.crn,#(lf)                ' ',#(lf)                COALESCE(sc.materia, ''),#(lf)                ' - ',#(lf)                COALESCE(sc.curso, ''),#(lf)                ' ',#(lf)                COALESCE(sc.nombre_curso, '')#(lf)            )#(lf)        END AS descripcion_nrc#(lf)    FROM nrc_solicitado AS n#(lf)    INNER JOIN propiedades AS p#(lf)        ON p.id = n.id#(lf)    LEFT JOIN seccion_curso AS sc#(lf)        ON sc.periodo = p.periodo#(lf)       AND sc.crn = n.crn#(lf)       AND sc.rn = 1#(lf)),#(lf)#(lf)nrc_pivot AS (#(lf)    SELECT#(lf)        id,#(lf)        MAX(CASE WHEN posicion = 1 THEN descripcion_nrc END) AS nrc1,#(lf)        MAX(CASE WHEN posicion = 2 THEN descripcion_nrc END) AS nrc2,#(lf)        MAX(CASE WHEN posicion = 3 THEN descripcion_nrc END) AS nrc3,#(lf)        MAX(CASE WHEN posicion = 4 THEN descripcion_nrc END) AS nrc4,#(lf)        MAX(CASE WHEN posicion = 5 THEN descripcion_nrc END) AS nrc5,#(lf)        MAX(CASE WHEN posicion = 6 THEN descripcion_nrc END) AS nrc6,#(lf)        MAX(CASE WHEN posicion = 7 THEN descripcion_nrc END) AS nrc7,#(lf)        MAX(CASE WHEN posicion = 8 THEN descripcion_nrc END) AS nrc8,#(lf)        MAX(CASE WHEN posicion = 9 THEN descripcion_nrc END) AS nrc9,#(lf)        MAX(CASE WHEN posicion = 10 THEN descripcion_nrc END) AS nrc10,#(lf)        MAX(CASE WHEN posicion = 11 THEN descripcion_nrc END) AS nrc11,#(lf)        MAX(CASE WHEN posicion = 12 THEN descripcion_nrc END) AS nrc12#(lf)    FROM nrc_detalle#(lf)    GROUP BY id#(lf))#(lf)#(lf)SELECT#(lf)    wf.id,#(lf)    wf.pd_id,#(lf)    wf.workflow_name AS name,#(lf)    p.rut_estudiante,#(lf)    p.nombre_estudiante,#(lf)    p.c_carrera,#(lf)    p.estado_alumno,#(lf)    p.email_alumno,#(lf)    p.nivel,#(lf)    p.periodo_adm,#(lf)    p.retencion,#(lf)    p.sede,#(lf)    p.secuencia_plan,#(lf)    p.pga,#(lf)    p.asignaturas_aprobadas,#(lf)    p.fecha_solicitud,#(lf)    p.periodo,#(lf)    p.c_codigo_solicitud,#(lf)    p.comentario,#(lf)    n.nrc1,#(lf)    p.resp_nrc1,#(lf)    n.nrc2,#(lf)    p.resp_nrc2,#(lf)    n.nrc3,#(lf)    p.resp_nrc3,#(lf)    n.nrc4,#(lf)    p.resp_nrc4,#(lf)    n.nrc5,#(lf)    p.resp_nrc5,#(lf)    n.nrc6,#(lf)    p.resp_nrc6,#(lf)    n.nrc7,#(lf)    p.resp_nrc7,#(lf)    n.nrc8,#(lf)    p.resp_nrc8,#(lf)    n.nrc9,#(lf)    p.resp_nrc9,#(lf)    n.nrc10,#(lf)    p.resp_nrc10,#(lf)    n.nrc11,#(lf)    p.resp_nrc11,#(lf)    n.nrc12,#(lf)    p.resp_nrc12,#(lf)    p.nrcs_solicitados,#(lf)    p.nrcs_rechazado,#(lf)    p.mensaje,#(lf)    wf.current_state AS estado_actual,#(lf)    wf.start_date,#(lf)    wf.stop_date,#(lf)    CAST(wf.running AS VARCHAR) AS ejecutandose,#(lf)    wf.last_state AS ultimo_estado,#(lf)    CAST(wf.originating_user_id AS VARCHAR) AS originating_user_id,#(lf)    CAST(wf.originating_event_id AS VARCHAR) AS originating_event_id,#(lf)    CAST(wf.originating_process_id AS VARCHAR) AS originating_process_id,#(lf)    CAST(wf.owner_role_id AS VARCHAR) AS owner_role_id,#(lf)    CAST(wf.admin_role_id AS VARCHAR) AS admin_role_id,#(lf)    CAST(wf.requires_execution_plan AS VARCHAR) AS requires_execution_plan,#(lf)    CASE#(lf)        WHEN wf.stop_date IS NOT NULL THEN 'FINALIZADA'#(lf)        WHEN LOWER(CAST(wf.running AS VARCHAR)) = 'false' THEN 'FINALIZADA'#(lf)        ELSE 'EN CURSO'#(lf)    END AS estado_operacional#(lf)FROM workflow_base AS wf#(lf)INNER JOIN propiedades AS p#(lf)    ON p.id = wf.id#(lf)LEFT JOIN nrc_pivot AS n#(lf)    ON n.id = wf.id;#(lf)"
		in
		    Query
	lineageTag: 0207ee23-342e-47ec-a5d0-7526ebc265a1
	queryGroup: Queries

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

expression query_solicitudes_calificacion =
		let
		    Query = "-- Reporte WF Solicitud de cambio de calificacion#(lf)-- Version Data Lake optimizada para Amazon Athena / Trino.#(lf)--#(lf)-- La tabla de propiedades se agrega una sola vez. Esto reemplaza las#(lf)-- subconsultas correlacionadas que consultaban ENG_PROPERTIES_VALUES por#(lf)-- separado para cada columna del resultado.#(lf)--#(lf)-- La consulta no fija periodo y carga el historico completo del workflow.#(lf)-- Para cambiar el tipo de workflow, modificar solamente el pd_id del CTE parametros.#(lf)-- 2026-08-21: se homologa la limpieza operacional de comentarios y se#(lf)-- reemplazan comas por punto para evitar cortes al exportar como CSV.#(lf)#(lf)WITH parametros AS (#(lf)    SELECT CAST(17504561 AS BIGINT) AS pd_id#(lf)),#(lf)#(lf)workflow_base AS (#(lf)    SELECT#(lf)        wf.id,#(lf)        wf.pd_id,#(lf)        wf.name AS workflow_name,#(lf)        wf.current_state,#(lf)        wf.start_date,#(lf)        wf.stop_date,#(lf)        wf.running,#(lf)        wf.last_state,#(lf)        wf.originating_user_id,#(lf)        wf.originating_event_id,#(lf)        wf.originating_process_id,#(lf)        wf.owner_role_id,#(lf)        wf.admin_role_id,#(lf)        wf.requires_execution_plan#(lf)    FROM uss_datalake_stage.banner_oracle_workflow_eng_workflow AS wf#(lf)    CROSS JOIN parametros AS par#(lf)    WHERE wf.pd_id = par.pd_id#(lf)),#(lf)#(lf)propiedades AS (#(lf)    SELECT#(lf)        epv.id,#(lf)        MAX(CASE WHEN epv.name = 'C_DESC_ESTADO_ESTUDIANTE' THEN epv.value END) AS desc_estado_estudiante,#(lf)        MAX(CASE WHEN epv.name = 'C_PERIODO' THEN epv.value END) AS periodo,#(lf)        MAX(CASE WHEN epv.name = 'C_NRC' THEN epv.value END) AS nrc,#(lf)        MAX(CASE WHEN epv.name = 'C_CURSO' THEN epv.value END) AS curso,#(lf)        MAX(CASE WHEN epv.name = 'C_COD_SEDE' THEN epv.value END) AS cod_sede,#(lf)        MAX(CASE WHEN epv.name = 'C_SEDE' THEN epv.value END) AS sede,#(lf)        MAX(CASE WHEN epv.name = 'C_FECHA_SOLICITUD' THEN epv.value END) AS fecha_solicitud,#(lf)        MAX(CASE WHEN epv.name = 'C_CARRERA' THEN epv.value END) AS cod_carrera,#(lf)        MAX(CASE WHEN epv.name = 'C_NOMBRE_CARRERA' THEN epv.value END) AS nombre_carrera,#(lf)        MAX(CASE WHEN epv.name = 'C_NOMESCUELA' THEN epv.value END) AS nomescuela,#(lf)        MAX(CASE WHEN epv.name = 'C_OBSERVACION_SZARSOL' THEN epv.value END) AS observacion_szarsol,#(lf)        MAX(CASE WHEN epv.name = 'C_SEQPLAN' THEN epv.value END) AS seqplan,#(lf)        MAX(CASE WHEN epv.name = 'C_NIVEL' THEN epv.value END) AS nivel,#(lf)        MAX(CASE WHEN epv.name = 'C_CALIFICACION_ACTUAL' THEN REPLACE(epv.value, '.', ',') END) AS calificacion_actual,#(lf)        MAX(CASE WHEN epv.name = 'C_CALIFICACION_SOLICITADA' THEN REPLACE(epv.value, '.', ',') END) AS calificacion_solicitada,#(lf)        MAX(CASE WHEN epv.name = 'C_RUT_SOLICITANTE' THEN epv.value END) AS rut_solicitante,#(lf)        MAX(CASE WHEN epv.name = 'C_NOMBRE_SOLICITANTE' THEN epv.value END) AS nombre_solicitante,#(lf)        MAX(CASE WHEN epv.name = 'C_RUT_ESTUDIANTE' THEN epv.value END) AS rut_estudiante,#(lf)        MAX(CASE WHEN epv.name = 'C_NOMBRE_ESTUDIANTE' THEN epv.value END) AS nombre_estudiante,#(lf)        MAX(CASE WHEN epv.name = 'C_CORREO_ESTUDIANTE' THEN epv.value END) AS correo_estudiante,#(lf)        MAX(CASE WHEN epv.name = 'C_FONO_ESTUDIANTE' THEN epv.value END) AS fono_estudiante,#(lf)        MAX(CASE WHEN epv.name = 'C_RUT_DOCENTE' THEN epv.value END) AS rut_docente,#(lf)        MAX(CASE WHEN epv.name = 'C_NOMBRE_DOCENTE' THEN epv.value END) AS nombre_docente,#(lf)        MAX(CASE WHEN epv.name = 'C_CORREO_DOCENTE' THEN epv.value END) AS correo_docente,#(lf)        MAX(CASE WHEN epv.name = 'C_GLOSA' THEN epv.value END) AS glosa,#(lf)        MAX(CASE WHEN epv.name = 'C_RUT_DECANO' THEN epv.value END) AS rut_decano,#(lf)        MAX(CASE WHEN epv.name = 'C_NOMBRE_DECANO' THEN epv.value END) AS nombre_decano,#(lf)        MAX(CASE WHEN epv.name = 'C_CORREO_DECANO' THEN epv.value END) AS correo_decano,#(lf)        MAX(CASE WHEN epv.name = 'C_RUT_DIRECTOR_ACADEMICO' THEN epv.value END) AS rut_director_academico,#(lf)        MAX(CASE WHEN epv.name = 'C_NOMBRE_DIRECTOR_ACADEMICO' THEN epv.value END) AS nombre_director_academico,#(lf)        MAX(CASE WHEN epv.name = 'C_CORREO_DIRECTOR_ACADEMICO' THEN epv.value END) AS correo_director_academico,#(lf)        MAX(CASE WHEN epv.name = 'C_RUT_DC_O_DD' THEN epv.value END) AS rut_dc_o_dd,#(lf)        MAX(CASE WHEN epv.name = 'C_NOMBRE_DC_O_DD' THEN epv.value END) AS nombre_dc_o_dd,#(lf)        MAX(CASE WHEN epv.name = 'C_CORREO_DC_O_DD' THEN epv.value END) AS correo_dc_o_dd,#(lf)        MAX(CASE WHEN epv.name = 'C_RUT_REGISTRO_ACADEMICO' THEN epv.value END) AS rut_registro_academico,#(lf)        MAX(CASE WHEN epv.name = 'C_NOMBRE_REGISTRO_ACADEMICO' THEN epv.value END) AS nombre_registro_academico,#(lf)        MAX(CASE WHEN epv.name = 'C_CORREO_REGISTRO_ACADEMICO' THEN epv.value END) AS correo_registro_academico,#(lf)        MAX(CASE WHEN epv.name = 'C_NOMBRE_TITULOS_Y_GRADOS' THEN epv.value END) AS nombre_titulos_y_grados,#(lf)        MAX(CASE WHEN epv.name = 'C_CORREO_TITULOS_Y_GRADOS' THEN epv.value END) AS correo_titulos_y_grados,#(lf)        ARRAY_JOIN(#(lf)            ARRAY_AGG(#(lf)                DISTINCT REPLACE(TRIM(REGEXP_REPLACE(epv.value, '[\r\n\t]+', ' ')), ',', '.')#(lf)            ) FILTER (WHERE epv.name = 'C_COMETARIO_SOLICITANTE'),#(lf)            ' | '#(lf)        ) AS comentario_solicitante#(lf)    FROM uss_datalake_stage.banner_oracle_workflow_eng_properties_values AS epv#(lf)    INNER JOIN workflow_base AS wf#(lf)        ON wf.id = epv.id#(lf)    WHERE epv.name IN (#(lf)        'C_DESC_ESTADO_ESTUDIANTE', 'C_PERIODO', 'C_NRC', 'C_CURSO',#(lf)        'C_COD_SEDE', 'C_SEDE', 'C_FECHA_SOLICITUD', 'C_CARRERA',#(lf)        'C_NOMBRE_CARRERA', 'C_NOMESCUELA', 'C_OBSERVACION_SZARSOL',#(lf)        'C_SEQPLAN', 'C_NIVEL', 'C_CALIFICACION_ACTUAL',#(lf)        'C_CALIFICACION_SOLICITADA', 'C_RUT_SOLICITANTE',#(lf)        'C_NOMBRE_SOLICITANTE', 'C_RUT_ESTUDIANTE',#(lf)        'C_NOMBRE_ESTUDIANTE', 'C_CORREO_ESTUDIANTE',#(lf)        'C_FONO_ESTUDIANTE', 'C_RUT_DOCENTE', 'C_NOMBRE_DOCENTE',#(lf)        'C_CORREO_DOCENTE', 'C_GLOSA', 'C_RUT_DECANO', 'C_NOMBRE_DECANO',#(lf)        'C_CORREO_DECANO', 'C_RUT_DIRECTOR_ACADEMICO',#(lf)        'C_NOMBRE_DIRECTOR_ACADEMICO', 'C_CORREO_DIRECTOR_ACADEMICO',#(lf)        'C_RUT_DC_O_DD', 'C_NOMBRE_DC_O_DD', 'C_CORREO_DC_O_DD',#(lf)        'C_RUT_REGISTRO_ACADEMICO', 'C_NOMBRE_REGISTRO_ACADEMICO',#(lf)        'C_CORREO_REGISTRO_ACADEMICO', 'C_NOMBRE_TITULOS_Y_GRADOS',#(lf)        'C_CORREO_TITULOS_Y_GRADOS', 'C_COMETARIO_SOLICITANTE'#(lf)    )#(lf)    GROUP BY epv.id#(lf))#(lf)#(lf)SELECT#(lf)    wf.id,#(lf)    wf.pd_id,#(lf)    wf.workflow_name AS name,#(lf)    p.desc_estado_estudiante,#(lf)    p.periodo,#(lf)    p.nrc,#(lf)    p.curso,#(lf)    p.cod_sede,#(lf)    p.sede,#(lf)    p.fecha_solicitud,#(lf)    p.cod_carrera,#(lf)    p.nombre_carrera,#(lf)    p.nomescuela,#(lf)    p.observacion_szarsol,#(lf)    p.seqplan,#(lf)    p.nivel,#(lf)    p.calificacion_actual,#(lf)    p.calificacion_solicitada,#(lf)    p.rut_solicitante,#(lf)    p.nombre_solicitante,#(lf)    p.rut_estudiante,#(lf)    p.nombre_estudiante,#(lf)    p.correo_estudiante,#(lf)    p.fono_estudiante,#(lf)    p.rut_docente,#(lf)    p.nombre_docente,#(lf)    p.correo_docente,#(lf)    p.glosa,#(lf)    p.rut_decano,#(lf)    p.nombre_decano,#(lf)    p.correo_decano,#(lf)    p.rut_director_academico,#(lf)    p.nombre_director_academico,#(lf)    p.correo_director_academico,#(lf)    p.rut_dc_o_dd,#(lf)    p.nombre_dc_o_dd,#(lf)    p.correo_dc_o_dd,#(lf)    p.rut_registro_academico,#(lf)    p.nombre_registro_academico,#(lf)    p.correo_registro_academico,#(lf)    p.nombre_titulos_y_grados,#(lf)    p.correo_titulos_y_grados,#(lf)    p.comentario_solicitante,#(lf)    wf.current_state AS estado_actual,#(lf)    wf.start_date,#(lf)    wf.stop_date,#(lf)    CAST(wf.running AS VARCHAR) AS ejecutandose,#(lf)    wf.last_state AS ultimo_estado,#(lf)    CAST(wf.originating_user_id AS VARCHAR) AS originating_user_id,#(lf)    CAST(wf.originating_event_id AS VARCHAR) AS originating_event_id,#(lf)    CAST(wf.originating_process_id AS VARCHAR) AS originating_process_id,#(lf)    CAST(wf.owner_role_id AS VARCHAR) AS owner_role_id,#(lf)    CAST(wf.admin_role_id AS VARCHAR) AS admin_role_id,#(lf)    CAST(wf.requires_execution_plan AS VARCHAR) AS requires_execution_plan,#(lf)    CASE#(lf)        WHEN wf.stop_date IS NOT NULL THEN 'FINALIZADA'#(lf)        WHEN LOWER(CAST(wf.running AS VARCHAR)) = 'false' THEN 'FINALIZADA'#(lf)        ELSE 'EN CURSO'#(lf)    END AS estado_operacional#(lf)FROM workflow_base AS wf#(lf)INNER JOIN propiedades AS p#(lf)    ON p.id = wf.id;#(lf)"
		in
		    Query
