	column fecha_inicio =
			VAR epoch = [start_date]
			VAR epoch_seconds = IF ( epoch > 9999999999, DIVIDE ( epoch, 1000 ), epoch )
			RETURN
				IF (
					ISBLANK ( epoch ),
					BLANK (),
					DATE ( 1970, 1, 1 ) + DIVIDE ( epoch_seconds, 86400 )
				)
		dataType: dateTime
		formatString: General Date
		lineageTag: c0bb37d1-1cb6-4329-a5c9-860fe49aded1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column fecha_cierre =
			VAR epoch = [stop_date]
			VAR epoch_seconds = IF ( epoch > 9999999999, DIVIDE ( epoch, 1000 ), epoch )
			RETURN
				IF (
					ISBLANK ( epoch ),
					BLANK (),
					DATE ( 1970, 1, 1 ) + DIVIDE ( epoch_seconds, 86400 )
				)
		dataType: dateTime
		formatString: General Date
		lineageTag: b8801ad2-3273-4926-9c75-7fd452dc1736
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition solicitudes_workflow = m
		mode: import
		queryGroup: Datos
		source =
				let
