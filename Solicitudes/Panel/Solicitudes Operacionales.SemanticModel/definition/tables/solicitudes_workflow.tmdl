	column fecha_inicio =
			VAR epoch = [start_date]
			VAR epoch_seconds = IF ( epoch > 9999999999, DIVIDE ( epoch, 1000 ), epoch )
			RETURN
				IF (
					ISBLANK ( epoch ),
					BLANK (),
					DATE ( 1970, 1, 1 ) + DIVIDE ( epoch_seconds, 86400 )
				)
		dataType: dateTime
		formatString: General Date
		lineageTag: 0b472fab-9c87-4433-a6c3-9ebf26c18caf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column fecha_cierre =
			VAR epoch = [stop_date]
			VAR epoch_seconds = IF ( epoch > 9999999999, DIVIDE ( epoch, 1000 ), epoch )
			RETURN
				IF (
					ISBLANK ( epoch ),
					BLANK (),
					DATE ( 1970, 1, 1 ) + DIVIDE ( epoch_seconds, 86400 )
				)
		dataType: dateTime
		formatString: General Date
		lineageTag: 73a7aed3-0d71-4d54-9e04-a7448ff84e6e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition solicitudes_workflow = m
