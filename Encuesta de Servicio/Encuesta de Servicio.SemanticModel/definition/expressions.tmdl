expression query_dim_carrera =
		let
				    Source = "
				WITH csks_enriquecido AS (
				    SELECT
				        a.*,
				        substr(a.kostl, 5, 4) AS sap_cod_carrera,
				        substr(a.khinr, 1, 4) AS sap_cod_facultad,
				        trim(split_part(b.descript, '-', 2)) AS nivel_academico,
				        trim(split_part(b.descript, '-', 3)) AS clasificacion_nivel,
				        b.descript AS sap_descripcion_jerarquia
				    FROM uss_datalake_stage.sap_odata_co_csks AS a
				    INNER JOIN uss_datalake_stage.sap_odata_fi_setheadert AS b
				        ON  a.khinr    = b.setname
				        AND b.setclass = '0101'
				        AND b.langu    = 'ES'
				    WHERE a.bukrs = '1000'
				),
				carreras_base AS (
				    SELECT
				        x.sap_cod_carrera,
				        d.stvmajr_desc AS banner_carrera,
				        CASE
				            WHEN d.stvmajr_desc IS NULL THEN NULL
				            ELSE trim(
				                regexp_replace(
				                    regexp_replace(
				                        regexp_replace(
				                            upper(d.stvmajr_desc),
				                            '\s*\([^)]*\)',
				                            ''
				                        ),
				                        '[\s\.](ADVANCE|ADVAN|ADVA|ADV|AV|VESPERTINO|VESPERT|VESPE|VESP|VES|ONLINE|ONL|SEMIPRESENCIAL|SEMIPRESENCIA|SEMIPRESEN|SEMIPRESENC|SEMIPRESE|SEMIPRES|SEMIPRE|SEMIP|SEMI|AOL|TRIMESTRAL|INICIAL|9TR)$',
				                        ''
				                    ),
				                    '(\s{2,}|\.$)',
				                    ' '
				                )
				            )
				        END AS carrera_banner_agrupada,
				        x.sap_cod_facultad,
				        c.descript AS sap_facultad,
				        x.nivel_academico,
				        x.clasificacion_nivel,
				        row_number() OVER (
				            PARTITION BY x.sap_cod_carrera
				            ORDER BY x.sap_cod_facultad
				        ) AS rn
				    FROM csks_enriquecido x
				    LEFT JOIN uss_datalake_stage.sap_odata_fi_setheadert c
				        ON substr(x.khinr, 1, 4) = c.setname
				        AND c.setclass = '0101'
				        AND c.langu    = 'ES'
				    LEFT JOIN uss_datalake_stage.banner_oracle_saturn_stvmajr d
				        ON x.sap_cod_carrera = d.stvmajr_code
				    WHERE x.nivel_academico <> 'Administrativo'
				)
				SELECT
				    sap_cod_carrera,
				    banner_carrera,
				    carrera_banner_agrupada,
				    sap_cod_facultad,
				    sap_facultad,
				    nivel_academico,
				    clasificacion_nivel
				FROM carreras_base
				WHERE rn = 1
				"
				in
				    Source
	lineageTag: af7de20e-3283-455c-9825-4fb3420c2d21
	queryGroup: Detalles

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Text

expression query_dim_facultad =
		let
				    Source = "
				WITH csks_enriquecido AS (
				    SELECT
				        substr(a.khinr, 1, 4) AS sap_cod_facultad,
				        c.descript            AS sap_facultad,
		
				        row_number() OVER (
				            PARTITION BY substr(a.khinr, 1, 4)
				            ORDER BY c.descript
				        ) AS rn
		
				    FROM uss_datalake_stage.sap_odata_co_csks AS a
		
				    INNER JOIN uss_datalake_stage.sap_odata_fi_setheadert AS b
				        ON  a.khinr    = b.setname
				        AND b.setclass = '0101'
				        AND b.langu    = 'ES'
		
				    LEFT JOIN uss_datalake_stage.sap_odata_fi_setheadert AS c
				        ON substr(a.khinr, 1, 4) = c.setname
				        AND c.setclass = '0101'
				        AND c.langu    = 'ES'
		
				    WHERE a.bukrs = '1000'
				)
		
				SELECT
				    sap_cod_facultad,
				    sap_facultad
				FROM csks_enriquecido
				WHERE rn = 1
				"
				in
				    Source
	lineageTag: f4fc8681-917e-4603-9f3c-baff8ae287e3
	queryGroup: Detalles

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Text

expression query_dim_campus =
		let
		    Source = "
		WITH campus_stvcamp AS (
		    SELECT DISTINCT
		        UPPER(TRIM(stvcamp_code)) AS cod_campus,
		        TRIM(stvcamp_desc) AS campus
		    FROM uss_datalake_stage.banner_oracle_saturn_stvcamp
		    WHERE stvcamp_code IS NOT NULL
		      AND TRIM(stvcamp_code) <> ''
		)
		SELECT
		    cod_campus,
		    campus,
		    CASE
		        WHEN UPPER(campus) LIKE '%CONCEPCIÓN%'
		          OR UPPER(campus) LIKE '%CONCEPCION%' THEN 'CONCEPCIÓN'
		        WHEN UPPER(campus) LIKE '%VALDIVIA%' THEN 'VALDIVIA'
		        WHEN UPPER(campus) LIKE '%PTO. MONTT%'
		          OR UPPER(campus) LIKE '%PUERTO MONTT%'
		          OR UPPER(campus) LIKE '%OSORNO%' THEN 'PATAGONIA'
		        WHEN UPPER(campus) LIKE '%VIRTUAL%'
		          OR cod_campus = 'ONL' THEN 'ONLINE'
		        WHEN UPPER(campus) LIKE '%SANTIAGO%'
		          OR cod_campus IN ('CIZ', 'OGE', 'RCG') THEN 'SANTIAGO'
		        ELSE 'SIN MAPEO'
		    END AS ciudad
		FROM campus_stvcamp
		"
		in
		    Source
	lineageTag: 0cd0ad2e-cc4b-4250-aaa1-604f0d4a94a9
