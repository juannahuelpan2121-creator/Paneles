table maestro_estudiantes
	lineageTag: 13f639d8-4117-480a-99a7-f425c008adbf

	column origen_maestro =
			VAR CodigoNivel = UPPER ( TRIM ( COALESCE ( maestro_estudiantes[nivel_academico], "" ) ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        CodigoNivel = "UG", "Pregrado",
			        CodigoNivel = "AV", "Advance",
			        CodigoNivel IN { "MG", "DP", "PH", "PE" }, "Postgrado",
			        BLANK ()
			    )
		dataType: string
		lineageTag: 8c2f13c0-8b34-43ea-95ce-61b38d9443b8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

