	partition maestro_estudiantes = m
		mode: import
		queryGroup: Detalles
		source = ```
				let
				    Pregrado = Odbc.Query("dsn=" & AthenaDSN, query_maestro_pregrado),
				    Advance = Odbc.Query("dsn=" & AthenaDSN, query_maestro_advance),
				    Postgrado = Odbc.Query("dsn=" & AthenaDSN, query_maestro_postgrado),
				    
				    Combinadas = Table.Combine({Pregrado, Advance, Postgrado})
				in
				    Combinadas
				```

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Exception

