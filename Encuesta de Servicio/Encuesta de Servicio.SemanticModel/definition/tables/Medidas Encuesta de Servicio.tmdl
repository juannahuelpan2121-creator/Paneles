		lineageTag: fb760d0c-5258-4212-9a56-50ce8c7af389

	measure 'Promedio Ponderado' =
			VAR Numerador =
			    SUMX (
			        SUMMARIZE (
			            encuestas_docentes,
			            encuestas_docentes[llave],
			            "Puntos",
			                SUMX (
			                    encuestas_docentes,
			                    encuestas_docentes[votos_nota_1] * 1
			                        + encuestas_docentes[votos_nota_2] * 2
			                        + encuestas_docentes[votos_nota_3] * 3
			                        + encuestas_docentes[votos_nota_4] * 4
			                        + encuestas_docentes[votos_nota_5] * 5
			                )
			        ),
			        [Puntos] * [Factor asignación nivel NRC]
			    )
			RETURN DIVIDE ( Numerador, [Respuestas escala 1-5] )
		formatString: 0.00
		displayFolder: 02 Indicadores
		lineageTag: 8947cd2e-67e8-4b98-be54-fcd9df6afd3d

	measure '% Cumpl. Meta Inscritos' = [% Cobertura]
		formatString: 0.0%
		displayFolder: 90 Compatibilidad visual
		lineageTag: 4f928f12-c1fd-4199-9249-062301913581

	measure 'Brecha vs Meta (est.)' = [N° Respuestas Regular] - [N° Respuestas Retirado]
		formatString: +#,0;-#,0;0
