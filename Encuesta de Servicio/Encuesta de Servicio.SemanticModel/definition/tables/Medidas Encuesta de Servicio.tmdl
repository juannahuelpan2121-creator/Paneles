table 'Medidas Encuesta de Servicio'
	lineageTag: d8ced118-dd97-442d-a13c-ff21146f130e

	measure 'Factor asignación nivel NRC' =
			VAR HayFiltroNivel = ISFILTERED ( dim_nivel_academico[nivel_academico] )
			VAR NivelesSeleccionados = VALUES ( dim_nivel_academico[nivel_academico] )
			VAR LlaveActual = SELECTEDVALUE ( encuestas_docentes[llave] )
			VAR InscritosTotalesNRC =
			    CALCULATE (
			        DISTINCTCOUNT ( inscripciones_estudiantes[id_estudiante] ),
			        REMOVEFILTERS ( dim_nivel_academico ),
			        REMOVEFILTERS ( inscripciones_estudiantes[nivel_academico] ),
			        inscripciones_estudiantes[es_inscrito_real] = 1,
			        TREATAS ( { LlaveActual }, inscripciones_estudiantes[llave_periodo_nrc] )
			    )
			VAR InscritosNivelNRC =
			    CALCULATE (
			        DISTINCTCOUNT ( inscripciones_estudiantes[id_estudiante] ),
			        inscripciones_estudiantes[es_inscrito_real] = 1,
			        TREATAS ( NivelesSeleccionados, inscripciones_estudiantes[nivel_academico] ),
			        TREATAS ( { LlaveActual }, inscripciones_estudiantes[llave_periodo_nrc] )
			    )
			RETURN
			    IF ( HayFiltroNivel, DIVIDE ( InscritosNivelNRC, InscritosTotalesNRC ), 1 )
		isHidden
		lineageTag: c365f42a-c568-41be-93c0-3f7aad855450

	measure 'N° Respuestas' =
			VAR TablaRespuestas =
			    SUMMARIZE (
			        encuestas_docentes,
			        encuestas_docentes[llave],
			        encuestas_docentes[periodo],
			        encuestas_docentes[nrc],
			        encuestas_docentes[codigo_encuesta],
			        "Respondidas", MAX ( encuestas_docentes[total_respuestas] )
			    )
			RETURN
			    SUMX ( TablaRespuestas, [Respondidas] * [Factor asignación nivel NRC] )
		formatString: #,0
		displayFolder: 01 KPI
		lineageTag: 7f840e46-190d-4c7e-9f05-fefac254ecca

	measure 'N° Respuestas Regular' =
			SUMX (
			    SUMMARIZE (
			        encuestas_docentes,
			        encuestas_docentes[llave],
			        "Votos", SUM ( encuestas_docentes[votos_4_y_5] )
			    ),
			    [Votos] * [Factor asignación nivel NRC]
			)
		formatString: #,0
		displayFolder: 01 KPI
		lineageTag: ff644afc-8349-4199-bfde-f2f1b6288ea4

	measure 'N° Respuestas Retirado' =
			SUMX (
			    SUMMARIZE (
			        encuestas_docentes,
			        encuestas_docentes[llave],
			        "Votos", SUM ( encuestas_docentes[votos_1_y_2] )
			    ),
			    [Votos] * [Factor asignación nivel NRC]
			)
		formatString: #,0
		displayFolder: 01 KPI
		lineageTag: 3a647bdc-9d3c-48f3-a436-72a9385ff0f6

	measure 'N° Respuestas Otros' =
			SUMX (
			    SUMMARIZE (
			        encuestas_docentes,
			        encuestas_docentes[llave],
			        "Votos", SUM ( encuestas_docentes[votos_nota_3] )
			    ),
			    [Votos] * [Factor asignación nivel NRC]
			)
		formatString: #,0
		displayFolder: 01 KPI
		lineageTag: 773bd1c6-f51d-418e-b096-68bab86e4f66

	measure Inscritos =
			VAR HayFiltroNivel = ISFILTERED ( dim_nivel_academico[nivel_academico] )
			VAR NivelesSeleccionados = VALUES ( dim_nivel_academico[nivel_academico] )
			VAR LlavesEncuesta =
			    DISTINCT (
			        SELECTCOLUMNS (
			            encuestas_docentes,
			            "LlaveEncuesta", encuestas_docentes[periodo] & "|" & encuestas_docentes[nrc]
			        )
			    )
			VAR InscripcionesEncuesta =
			    CALCULATETABLE (
			        DISTINCT (
			            SELECTCOLUMNS (
			                inscripciones_estudiantes,
			                "EstudiantePeriodo", inscripciones_estudiantes[periodo] & "|" & inscripciones_estudiantes[id_estudiante]
			            )
			        ),
			        inscripciones_estudiantes[es_inscrito_real] = 1,
			        TREATAS ( LlavesEncuesta, inscripciones_estudiantes[llave_periodo_nrc] )
			    )
			VAR InscripcionesEncuestaNivel =
			    CALCULATETABLE (
			        DISTINCT (
			            SELECTCOLUMNS (
			                inscripciones_estudiantes,
			                "EstudiantePeriodo", inscripciones_estudiantes[periodo] & "|" & inscripciones_estudiantes[id_estudiante]
			            )
			        ),
			        inscripciones_estudiantes[es_inscrito_real] = 1,
			        TREATAS ( NivelesSeleccionados, inscripciones_estudiantes[nivel_academico] ),
			        TREATAS ( LlavesEncuesta, inscripciones_estudiantes[llave_periodo_nrc] )
			    )
			RETURN
			    IF ( HayFiltroNivel, COUNTROWS ( InscripcionesEncuestaNivel ), COUNTROWS ( InscripcionesEncuesta ) )
		formatString: #,0
		displayFolder: 01 KPI
		lineageTag: 21e28624-a8ac-4b95-b38e-5853abdc4b0f

	measure 'Inscritos otros estados' =
			VAR HayFiltroNivel = ISFILTERED ( dim_nivel_academico[nivel_academico] )
			VAR NivelesSeleccionados = VALUES ( dim_nivel_academico[nivel_academico] )
			VAR LlavesEncuesta = DISTINCT ( SELECTCOLUMNS ( encuestas_docentes, "Llave", encuestas_docentes[llave] ) )
			VAR ParesEstudiantePeriodo =
			    CALCULATETABLE (
			        DISTINCT (
			            SELECTCOLUMNS (
			                inscripciones_estudiantes,
			                "EstudiantePeriodo", inscripciones_estudiantes[periodo] & "|" & inscripciones_estudiantes[id_estudiante]
			            )
			        ),
			        inscripciones_estudiantes[es_inscrito_real] = 0,
			        TREATAS ( LlavesEncuesta, inscripciones_estudiantes[llave_periodo_nrc] )
			    )
			VAR ParesEstudiantePeriodoNivel =
			    CALCULATETABLE (
			        DISTINCT (
			            SELECTCOLUMNS (
			                inscripciones_estudiantes,
			                "EstudiantePeriodo", inscripciones_estudiantes[periodo] & "|" & inscripciones_estudiantes[id_estudiante]
			            )
			        ),
			        inscripciones_estudiantes[es_inscrito_real] = 0,
			        TREATAS ( NivelesSeleccionados, inscripciones_estudiantes[nivel_academico] ),
			        TREATAS ( LlavesEncuesta, inscripciones_estudiantes[llave_periodo_nrc] )
			    )
			RETURN
			    IF ( HayFiltroNivel, COUNTROWS ( ParesEstudiantePeriodoNivel ), COUNTROWS ( ParesEstudiantePeriodo ) )
		formatString: #,0
		displayFolder: 01 KPI
		lineageTag: 0afed99b-34aa-41d9-ade9-560b3c2fd0ac

	measure 'Estudiantes en maestros' =
			VAR NivelesSeleccionados = VALUES ( dim_nivel_academico[nivel_academico] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( maestro_estudiantes[ID_ESTUDIANTE] ),
			        TREATAS ( NivelesSeleccionados, maestro_estudiantes[origen_maestro] )
			    )
		formatString: #,0
		displayFolder: 01 KPI
		lineageTag: 679463b4-236d-47a6-81ec-739e72f5b4b9

	measure 'N° Inscritos' = [Inscritos]
		formatString: #,0
		displayFolder: 01 KPI
		lineageTag: b8965206-8667-4e7d-a800-f3b59054885b

	measure 'Respuestas escala 1-5' = [N° Respuestas Regular] + [N° Respuestas Retirado] + [N° Respuestas Otros]
		formatString: #,0
		displayFolder: 02 Indicadores
		lineageTag: 0a4b5aed-08aa-4b85-9d91-3ed6c483db3d

	measure '% Cumpl. Meta Evaluación' =
			DIVIDE(
			    [N° Respuestas Regular] - [N° Respuestas Retirado],
			    [Respuestas escala 1-5]
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Indicadores
		lineageTag: 059801ed-879e-40a4-afc8-d8df45d36742

	measure 'N° Respuestas válidas' = [Respuestas escala 1-5]
		formatString: #,0
		displayFolder: 02 Indicadores
		lineageTag: 0fb8f778-c89b-4eaf-adbe-2c5e8b5cf3a7

	measure '% Neto (n>=10)' =
			IF(
			    [N° Respuestas válidas] >= 10,
			    [% Cumpl. Meta Evaluación],
			    BLANK()
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Indicadores
		lineageTag: bf9b720f-6b28-4019-954e-caf52c0264da

	measure '% Neto Servicios (P1-P13)' =
			CALCULATE(
			    [% Cumpl. Meta Evaluación],
			    REMOVEFILTERS(encuestas_docentes[secuencia]),
			    encuestas_docentes[secuencia] >= 1,
			    encuestas_docentes[secuencia] <= 13
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Apertura
		lineageTag: 7f56e641-894f-41e4-8f8d-04802c637c3e

	measure '% Satisfacción general (P14)' =
			CALCULATE(
			    [% Cumpl. Meta Evaluación],
			    REMOVEFILTERS(encuestas_docentes[secuencia]),
			    encuestas_docentes[secuencia] = 14
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Apertura
		lineageTag: 69456b4e-4a24-4c8f-a3f7-f5fda4f84c6c

	measure '% Recomendación (P15)' =
			CALCULATE(
			    [% Cumpl. Meta Evaluación],
			    REMOVEFILTERS(encuestas_docentes[secuencia]),
			    encuestas_docentes[secuencia] = 15
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Apertura
		lineageTag: 799670c3-9b2f-4b38-8a27-89834db06725

	measure '% Orgullo (P16)' =
			CALCULATE(
			    [% Cumpl. Meta Evaluación],
			    REMOVEFILTERS(encuestas_docentes[secuencia]),
			    encuestas_docentes[secuencia] = 16
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Apertura
		lineageTag: a22d414b-73f8-433e-966d-d9b053508633

	measure 'Brecha Neto vs período anterior' =
			VAR PeriodoActual = MAX(encuestas_docentes[periodo])
			VAR PeriodoAnterior =
			    MAXX(
			        FILTER(
			            ALL(encuestas_docentes[periodo]),
			            encuestas_docentes[periodo] < PeriodoActual
			        ),
			        encuestas_docentes[periodo]
			    )
			VAR NetoAnterior =
			    CALCULATE(
			        [% Cumpl. Meta Evaluación],
			        REMOVEFILTERS(encuestas_docentes[periodo]),
			        encuestas_docentes[periodo] = PeriodoAnterior
			    )
			RETURN
			    IF(NOT ISBLANK(NetoAnterior), [% Cumpl. Meta Evaluación] - NetoAnterior)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03 Apertura
		lineageTag: 67d51f5d-2296-44c3-96ae-22d6d38048ca

	measure '% Satisfacción' = DIVIDE([N° Respuestas Regular], [Respuestas escala 1-5])
		formatString: 0.0%
		displayFolder: 02 Indicadores
		lineageTag: 4602840e-73e2-4bff-9e0b-2276d86625e1

	measure '% Detractores' = DIVIDE([N° Respuestas Retirado], [Respuestas escala 1-5])
