	measure 'Tooltip Metodología' =
			"Neto = (votos 4+5 - votos 1+2) / votos 1 a 5. " &
			"Satisfacción = votos 4+5 / votos 1 a 5. " &
			"Se excluyen respuestas 0, 6 y 7 del neto. " &
			"Los cortes desagregados muestran el neto solo con 10 o más respuestas válidas. " &
			"Tasa por varios periodos = respuestas acumuladas / estudiantes-periodo inscritos. " &
			"El nivel proviene del maestro del mismo estudiante y periodo, plan AS y mayor secuencia. " &
			"Como la encuesta es anónima, los resultados por nivel se estiman según la composición de inscritos del mismo periodo y NRC. " &
			"Alcance: nombre_encuesta contiene SERVICIO."
		displayFolder: 91 UI
		lineageTag: 6da61e68-ef8d-4169-b1e3-e56e43b64c82

	measure Metodologia_HTML = "<style>html,body{margin:0;padding:0;width:100%;height:100%;overflow:hidden}.m{height:100vh;box-sizing:border-box;padding:22px 26px;border:1px solid #DCE2EA;border-left:5px solid #C6B27F;border-radius:10px;background:#fff;font-family:Arial;color:#263244}.t{font-size:22px;font-weight:700;color:#112B42;margin-bottom:12px}.g{display:grid;grid-template-columns:1fr 1fr;gap:12px}.b{padding:13px 15px;border-radius:8px;background:#F4F6F9}.h{font-size:13px;font-weight:700;color:#1746D1;margin-bottom:5px}.p{font-size:12px;line-height:1.45;color:#465166}</style><div class='m'><div class='t'>Metodología de Encuesta de Servicio</div><div class='g'><div class='b'><div class='h'>Alcance</div><div class='p'>Solo se incluyen registros cuyo nombre_encuesta contiene SERVICIO y preguntas evaluadas con ponderación mayor a cero.</div></div><div class='b'><div class='h'>Neto</div><div class='p'>(votos 4+5 - votos 1+2) / votos 1+2+3+4+5. Las respuestas 0, 6 y 7 se excluyen.</div></div><div class='b'><div class='h'>Nivel académico</div><div class='p'>Se obtiene del maestro de origen del estudiante para el mismo periodo: UG = Pregrado, AV = Advance y MG/DP/PH/PE = Postgrado. Se usa estado de plan AS y la mayor secuencia.</div></div><div class='b'><div class='h'>Tasa de respuesta</div><div class='p'>En varios periodos se comparan respuestas acumuladas con estudiantes-periodo inscritos en los NRC de encuesta con estado RE o RW.</div></div><div class='b'><div class='h'>Resultados por nivel</div><div class='p'>La fuente de encuesta no identifica al respondente. Por ello, al filtrar nivel, respuestas y votos se estiman proporcionalmente según los inscritos del mismo periodo y NRC; sin filtro se muestran totales reales.</div></div><div class='b'><div class='h'>Interpretación</div><div class='p'>Promotores = 4+5; neutros = 3; detractores = 1+2. P1-P13 servicios, P14 satisfacción, P15 recomendación y P16 orgullo.</div></div></div></div>"
		displayFolder: 91 UI
		lineageTag: beebfd65-8816-4a15-be43-41ed4afd906c

	measure Encabezado_Encuesta = ```
			
			    VAR titulo_base = "Encuesta de Servicio"
			    VAR subtitulo_base = "Satisfacción, neto, tasa de respuesta y evolución por contexto institucional."
			    VAR area_base = "Dirección General de Control de Gestión y Análisis Institucional"
			    VAR rotulo_filtros   = "Filtros aplicados:"
			    VAR max_len_texto    = 10
			    VAR color_fuente = "#000000"
			    VAR font_family  = "'Segoe UI', Arial, sans-serif"
			    VAR chip_style = "display:inline-flex;align-items:center;min-width:0;max-width:190px;padding:2px 8px;border-radius:999px;background:#EAF1FB;color:#001E61;font-family:Arial,Segoe UI,sans-serif;font-size:11px;line-height:20px;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;box-sizing:border-box;"
			    
			    // 1. Captura de Filtros (Encuestas)
			    VAR periodo_full = IF(ISFILTERED(encuestas_docentes[periodo]), CONCATENATEX(VALUES(encuestas_docentes[periodo]), encuestas_docentes[periodo], ", "), "Todos")
			    VAR periodo_display = IF(LEN(periodo_full) > max_len_texto, LEFT(periodo_full, max_len_texto) & "…", periodo_full)
			    
			VAR nivel_full = IF(ISFILTERED(dim_nivel_academico[nivel_academico]), CONCATENATEX(VALUES(dim_nivel_academico[nivel_academico]), dim_nivel_academico[nivel_academico], ", "), "Todos")
			    VAR nivel_display = IF(LEN(nivel_full) > max_len_texto, LEFT(nivel_full, max_len_texto) & "…", nivel_full)
			    
			    VAR campus_full = IF(ISFILTERED(encuestas_docentes[cod_campus]), CONCATENATEX(VALUES(encuestas_docentes[cod_campus]), encuestas_docentes[cod_campus], ", "), "Todos")
			    VAR campus_display = IF(LEN(campus_full) > max_len_texto, LEFT(campus_full, max_len_texto) & "…", campus_full)
			    
			    VAR facultad_full = IF(ISFILTERED(encuestas_docentes[cod_facultad]), CONCATENATEX(VALUES(encuestas_docentes[cod_facultad]), encuestas_docentes[cod_facultad], ", "), "Todos")
			    VAR facultad_display = IF(LEN(facultad_full) > max_len_texto, LEFT(facultad_full, max_len_texto) & "…", facultad_full)
			    
			    // 2. Construcción de Chips HTML base
			    VAR chip_periodo = "<span style='" & chip_style & "' title='" & periodo_full & "'>Periodo: <b>" & periodo_display & "</b></span>"
			    VAR chip_nivel = "<span style='" & chip_style & "' title='" & nivel_full & "'>Nivel: <b>" & nivel_display & "</b></span>"
			    VAR chip_campus = "<span style='" & chip_style & "' title='" & campus_full & "'>Campus: <b>" & campus_display & "</b></span>"
			    VAR chip_facultad = "<span style='" & chip_style & "' title='" & facultad_full & "'>Facultad: <b>" & facultad_display & "</b></span>"
			    
			    // 3. Parámetros de Truncado Dinámico
			    VAR ancho_disponible_chips = 1090
			    VAR ancho_maximo_chip = 190
			    VAR ancho_resumen = 82
			    VAR separacion_chips = 5
			    VAR padding_chip = 20
			    VAR px_caracter_etiqueta = 5.8
			    VAR px_caracter_valor = 6.2
			    VAR max_caracteres_valor = 28
			    
			    // 4. Tabla Lógica de Filtros
			    VAR tabla_filtros_base =
			        UNION(
			            ROW("orden", 1, "nombre", "Periodo", "valor", periodo_full, "html", "<span class='uss_chip_hover' title='" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Periodo: " & periodo_full, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "'", "&#39;") & "'>" & chip_periodo & "</span>", "ancho", MIN(ancho_maximo_chip, padding_chip + LEN("Periodo:") * px_caracter_etiqueta + MIN(max_caracteres_valor, LEN(periodo_full)) * px_caracter_valor)),
			            ROW("orden", 2, "nombre", "Nivel académico", "valor", nivel_full, "html", "<span class='uss_chip_hover' title='" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Nivel académico: " & nivel_full, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "'", "&#39;") & "'>" & chip_nivel & "</span>", "ancho", MIN(ancho_maximo_chip, padding_chip + LEN("Nivel:") * px_caracter_etiqueta + MIN(max_caracteres_valor, LEN(nivel_full)) * px_caracter_valor)),
			            ROW("orden", 3, "nombre", "Campus", "valor", campus_full, "html", "<span class='uss_chip_hover' title='" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Campus: " & campus_full, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "'", "&#39;") & "'>" & chip_campus & "</span>", "ancho", MIN(ancho_maximo_chip, padding_chip + LEN("Campus:") * px_caracter_etiqueta + MIN(max_caracteres_valor, LEN(campus_full)) * px_caracter_valor)),
			            ROW("orden", 4, "nombre", "Facultad", "valor", facultad_full, "html", "<span class='uss_chip_hover' title='" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Facultad: " & facultad_full, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "'", "&#39;") & "'>" & chip_facultad & "</span>", "ancho", MIN(ancho_maximo_chip, padding_chip + LEN("Facultad:") * px_caracter_etiqueta + MIN(max_caracteres_valor, LEN(facultad_full)) * px_caracter_valor))
			        )
			        
			    // 5. Cálculos de Espacio y Visibilidad
			    VAR cantidad_total = COUNTROWS(tabla_filtros_base)
			    VAR ancho_total = SUMX(tabla_filtros_base, [ancho]) + MAX(0, cantidad_total - 1) * separacion_chips
			    VAR requiere_resumen = ancho_total > ancho_disponible_chips
			    VAR ancho_para_visibles = ancho_disponible_chips - IF(requiere_resumen, ancho_resumen + separacion_chips, 0)
			    
			    VAR tabla_acumulada =
			        ADDCOLUMNS(
			            tabla_filtros_base,
			            "ancho_acumulado",
			            VAR orden_actual = [orden]
			            RETURN
			                SUMX(
			                    FILTER(tabla_filtros_base, [orden] <= orden_actual),
			                    [ancho]
			                ) + MAX(0, orden_actual - 1) * separacion_chips
			        )
			        
			    VAR cantidad_visible =
			        IF(
			            NOT requiere_resumen,
			            cantidad_total,
			            MAX(
			                1,
			                COALESCE(
			                    MAXX(
			                        FILTER(tabla_acumulada, [ancho_acumulado] <= ancho_para_visibles),
			                        [orden]
			                    ),
			                    1
			                )
			            )
			        )
			        
			    VAR tabla_visible = FILTER(tabla_filtros_base, [orden] <= cantidad_visible)
			    VAR tabla_oculta = FILTER(tabla_filtros_base, [orden] > cantidad_visible)
			    VAR cantidad_oculta = COUNTROWS(tabla_oculta)
			    
			    VAR detalle_oculto = CONCATENATEX(tabla_oculta, [nombre] & ": " & [valor], " | ", [orden], ASC)
			    VAR detalle_oculto_html = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(detalle_oculto, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "'", "&#39;")
			    
			    VAR chips = CONCATENATEX(tabla_filtros_base, [html], "", [orden], ASC)
			    VAR chip_resumen =
			        IF(
			            cantidad_oculta > 0,
			            "<span class='uss_more' title='Filtros adicionales: " & detalle_oculto_html & "'>+" & FORMAT(cantidad_oculta, "0") & " filtros</span>",
			            ""
			        )
			    VAR chips_visibles = IF(requiere_resumen, CONCATENATEX(tabla_visible, [html], "", [orden], ASC) & chip_resumen, chips)
			    
			    // 6. Retorno HTML + CSS Estructurado
			    RETURN
			        "<style>" &
			        "html,body{width:100%;height:100%;margin:0;padding:0;overflow:hidden;box-sizing:border-box;}" &
			        "#uss_header{position:relative;width:100%;height:100vh;min-height:100%;overflow:hidden;box-sizing:border-box;color:#112B42;font-family:Arial,Segoe UI,sans-serif;}" &
			        "#uss_divider{position:absolute;left:236px;top:18px;width:2px;height:60px;border-radius:2px;background:#C6B27F;}" &
			        "#uss_title_block{position:absolute;left:260px;top:12px;right:260px;overflow:visible;}" &
			        "#uss_title_row{display:flex;align-items:center;min-width:0;gap:8px;}" &
			        "#uss_title{display:block;min-width:0;font-size:23px;font-weight:700;line-height:29px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#112B42;}" &
			        "#uss_subtitle{margin-top:2px;font-size:12px;line-height:18px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#58616E;}" &
			        "#uss_area{margin-top:0;font-size:9.5px;font-weight:600;line-height:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#8A7440;}" &
			        "#uss_info{position:static;display:inline-flex;align-items:center;flex:0 0 auto;}" &
			        "#uss_info_dot{display:flex;align-items:center;justify-content:center;width:20px;height:20px;border-radius:50%;background:#C6B27F;color:#FFFFFF;font-size:11px;font-weight:700;line-height:20px;cursor:default;user-select:none;}" &
			        "#uss_info_panel{position:absolute;left:-24px;top:-8px;width:760px;max-width:calc(100vw - 260px);height:calc(100vh - 16px);overflow:hidden;box-sizing:border-box;border:1px solid #D9DEE7;border-left:4px solid #C6B27F;border-radius:8px;background:#FFFFFF;box-shadow:0 6px 18px rgba(17,43,66,.16);z-index:5;color:#334155;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .12s ease;}" &
			        "#uss_info:hover #uss_info_panel{opacity:1;visibility:visible;pointer-events:auto;}" &
			        "#uss_info_scroll{position:absolute;left:22px;right:48px;top:17px;bottom:31px;overflow-x:hidden;overflow-y:auto;overscroll-behavior:contain;scrollbar-gutter:stable;padding-right:6px;box-sizing:border-box;scrollbar-width:thin;scrollbar-color:#C6B27F transparent;}" &
			        "#uss_info_scroll::-webkit-scrollbar{width:5px;}" &
			        "#uss_info_scroll::-webkit-scrollbar-track{background:transparent;}" &
			        "#uss_info_scroll::-webkit-scrollbar-thumb{border-radius:999px;background:#C6B27F;}" &
			        "#uss_info_grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 18px;align-items:start;}" &
			        ".uss_info_item{min-width:0;padding-left:14px;border-left:1px solid #E8DFC8;}" &
			        ".uss_info_item:first-child{padding-left:0;border-left:0;}" &
			        ".uss_info_item b{display:block;margin:0 0 3px;color:#8A7440;font-size:10px;line-height:12px;}" &
			        ".uss_info_item span{display:block;margin:0;color:#334155;font-size:9px;line-height:12px;}" &
			        "#uss_info_source{position:absolute;left:22px;right:48px;bottom:9px;box-sizing:border-box;padding-top:4px;border-top:1px solid #E8EDF3;color:#58616E;font-size:8px;line-height:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}" &
			        "#uss_info_source b{color:#8A7440;font-weight:700;}" &
			        "#uss_filters{position:absolute;left:20px;right:14px;bottom:14px;height:24px;display:flex;align-items:center;gap:5px;white-space:nowrap;overflow:visible;}" &
			        "#uss_filters_label{flex:0 0 auto;margin-right:2px;font-size:12px;color:#475569;}" &
			        ".uss_chip_hover{display:inline-flex;align-items:center;flex:0 0 auto;min-width:0;cursor:default;}" &
			        ".uss_chip{position:relative;display:inline-flex;align-items:center;gap:3px;flex:0 0 auto;min-width:0;max-width:190px;height:24px;padding:2px 8px;border-radius:999px;background:#EAF1FB;color:#001E61;font-family:Arial,Segoe UI,sans-serif;font-size:11px;line-height:20px;white-space:nowrap;box-sizing:border-box;cursor:default;}" &
			        ".uss_chip_label{flex:0 0 auto;font-weight:400;}" &
			        ".uss_chip_value{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:700;}" &
			        ".uss_chip_hover:not([title$='Todos'])>span{background:#F4F0E3!important;border:1px solid #C6B27F!important;color:#112B42!important;padding:1px 7px!important;}" &
			        ".uss_chip_hover:not([title$='Todos'])>span b,.uss_chip_hover:not([title$='Todos']) .uss_chip_value{color:#7A6428!important;}" &
			        ".uss_more{flex:0 0 auto;padding:0 2px;color:#475569;font-size:11px;font-weight:600;line-height:20px;border-bottom:1px dotted #94A3B8;cursor:default;}" &
			        "</style>" &
			        "<div id='uss_header'>" &
			            "<div id='uss_divider'></div>" &
			            "<div id='uss_title_block'>" &
			                "<div id='uss_title_row'>" &
			                    "<div id='uss_title'>" & titulo_base & "</div>" &
			                    "<span id='uss_info'>" &
			                        "<span id='uss_info_dot' aria-label='Información' title='Pasa el cursor para ver más información'>i</span>" &
			                        "<div id='uss_info_panel' role='note'>" &
			                            "<div id='uss_info_scroll'>" &
			                                "<div id='uss_info_grid'>" &
			                                    "<div class='uss_info_item'><b>Cálculo y reglas</b><span>Neto = (votos 4+5 - votos 1+2) / votos 1 a 5. Se excluyen 0, 6 y 7. Los cortes requieren al menos 10 respuestas válidas.</span></div>" &
				                                    "<div class='uss_info_item'><b>Alcance de los datos</b><span>Encuestas SERVICIO. El nivel usa el maestro del mismo estudiante y periodo, plan AS y mayor secuencia: UG Pregrado, AV Advance y MG/DP/PH/PE Postgrado.</span></div>" &
				                                    "<div class='uss_info_item'><b>Cómo interpretar</b><span>La encuesta es anónima: por nivel, respuestas y votos son una estimación proporcional a los inscritos del mismo periodo y NRC. Sin filtro de nivel son totales reales.</span></div>" &
			                                "</div>" &
			                            "</div>" &
			                            "<div id='uss_info_source'><b>Fuente:</b> Banner / Athena. Tasa de respuesta = respondidas / estudiantes únicos RE-RW por periodo y NRC. Maestros: Pregrado, Advance y Postgrado.</div>" &
			                        "</div>" &
			                    "</span>" &
			                "</div>" &
			                "<div id='uss_subtitle'>" & subtitulo_base & "</div>" &
			                "<div id='uss_area'>" & area_base & "</div>" &
			            "</div>" &
			            "<div id='uss_filters'>" &
			                "<span id='uss_filters_label'>" & rotulo_filtros & "</span>" &
			                chips_visibles &
			            "</div>" &
			        "</div>"
			```
		displayFolder: 91 UI
		lineageTag: c9fe8910-8b44-452f-b3b6-f5b863d2f9e9

	measure 'HTML Universo Encuestas' =
			
			VAR v_Inscritos =
			    [Inscritos]
			
			VAR v_Respuestas =
			    [N° Respuestas]
			
			VAR v_Tasa =
			    IF ( ISBLANK ( [Tasa Respuesta] ), "Sin base", FORMAT ( [Tasa Respuesta], "0.0 %" ) )
			
			VAR t_Nivel =
			    COALESCE (
			        [Nivel académico encuesta],
			        "No definido"
			    )
			
			VAR t_OrigenMaestro =
			    COALESCE (
			        [Origen maestro encuesta],
			        "No definido"
			    )
			
			VAR v_Periodos =
			    VALUES ( encuestas_docentes[periodo] )
			
			VAR t_Periodo =
			    SWITCH (
			        TRUE (),
			        NOT ISFILTERED ( encuestas_docentes[periodo] ), "Todos",
			        COUNTROWS ( v_Periodos ) = 0, "No definido",
			        COUNTROWS ( v_Periodos ) = 1,
			            SELECTEDVALUE ( encuestas_docentes[periodo] ),
			        CONCATENATEX (
			            v_Periodos,
			            encuestas_docentes[periodo],
			            ", ",
			            encuestas_docentes[periodo],
			            ASC
				    )
			    )
			VAR t_UnidadUniverso =
			    IF ( COUNTROWS ( v_Periodos ) > 1, "registros estudiante-período", "estudiantes" )
			
			VAR v_Areas =
			    DISTINCTCOUNT (
			        encuestas_docentes[tipo_pregunta_area]
			    )
			
			VAR v_Preguntas =
			    DISTINCTCOUNT (
			        encuestas_docentes[texto_pregunta]
			    )
			
			VAR t_Inscritos =
			    FORMAT ( COALESCE ( v_Inscritos, 0 ), "#,##0" )
			
			VAR t_Respuestas =
			    FORMAT ( COALESCE ( v_Respuestas, 0 ), "#,##0" )
			
			VAR t_Areas =
			    FORMAT ( v_Areas, "#,##0" )
			
			VAR t_Preguntas =
			    FORMAT ( v_Preguntas, "#,##0" )
			
			RETURN
			    "
			    <style>
			        html, body {
			            margin: 0;
			            padding: 0;
			            font-family: 'Segoe UI', Arial, sans-serif;
			            background: transparent;
			        }
			
			        .uss-card {
			            width: 100%;
			            box-sizing: border-box;
			            padding: 20px 24px;
			            background: #FFFFFF;
			            border: 1px solid #D9DEE7;
			            border-left: 4px solid #C6B27F;
			            border-radius: 8px;
			            box-shadow: 0 4px 12px rgba(17,43,66,.08);
			            color: #334155;
			        }
			
			        .uss-title {
			            margin-bottom: 12px;
			            color: #112B42;
			            font-size: 16px;
			            font-weight: 700;
			        }
			
			        .uss-list {
			            margin: 0;
			            padding-left: 20px;
			            color: #58616E;
			            font-size: 14px;
			            line-height: 1.8;
			        }
			
			        .uss-list li {
			            margin-bottom: 4px;
			        }
			
			        .uss-highlight {
			            color: #112B42;
			            font-weight: 700;
			        }
			
			        .uss-source {
			            color: #64748B;
			            font-size: 12px;
			        }
			    </style>
			
			    <div class='uss-card'>
			        <div class='uss-title'>
			            Universo de Evaluación:
			        </div>
			
			        <ul class='uss-list'>
			            <li>
			                Nivel académico:
			                <span class='uss-highlight'>" & t_Nivel & "</span>
			                <span class='uss-source'>
			                    (origen: " & t_OrigenMaestro & ")
			                </span>
			            </li>
			
			            <li>
			                Período:
			                <span class='uss-highlight'>" & t_Periodo & "</span>
			            </li>
			
			            <li>
			                Instrumento compuesto por
			                <span class='uss-highlight'>" & t_Preguntas & "</span>
			                preguntas distribuidas en
			                <span class='uss-highlight'>" & t_Areas & "</span>
			                áreas evaluadas.
			            </li>
			
			            <li>
			                De un total de
			                <span class='uss-highlight'>" & t_Inscritos & "</span>
				                " & t_UnidadUniverso & ", fueron respondidas
			                <span class='uss-highlight'>" & t_Respuestas & "</span>
			                encuestas, alcanzando una tasa de
			                <span class='uss-highlight'>" & v_Tasa & "</span>.
			            </li>
			        </ul>
			    </div>
			    "
		lineageTag: dce444e0-a3f3-4143-97d5-dff7f97e6489

	measure 'Nivel académico encuesta' =
			VAR HayFiltroNivel = ISFILTERED ( dim_nivel_academico[nivel_academico] )
			VAR LlavesEncuesta =
			    DISTINCT ( SELECTCOLUMNS ( encuestas_docentes, "Llave", encuestas_docentes[llave] ) )
			VAR NivelesDelContexto =
			    CALCULATETABLE (
			        VALUES ( inscripciones_estudiantes[nivel_academico] ),
			        REMOVEFILTERS ( dim_nivel_academico ),
			        inscripciones_estudiantes[es_inscrito_real] = 1,
			        TREATAS ( LlavesEncuesta, inscripciones_estudiantes[llave_periodo_nrc] )
			    )
			VAR TextoSeleccion =
			    CONCATENATEX (
			        FILTER ( VALUES ( dim_nivel_academico[nivel_academico] ), NOT ISBLANK ( dim_nivel_academico[nivel_academico] ) ),
			        dim_nivel_academico[nivel_academico],
			        ", ",
			        dim_nivel_academico[nivel_academico],
			        ASC
			    )
			VAR TextoContexto =
			    CONCATENATEX (
			        FILTER ( NivelesDelContexto, NOT ISBLANK ( inscripciones_estudiantes[nivel_academico] ) ),
			        inscripciones_estudiantes[nivel_academico],
			        ", ",
			        inscripciones_estudiantes[nivel_academico],
			        ASC
			    )
			RETURN
			    IF ( HayFiltroNivel, TextoSeleccion, TextoContexto )
		lineageTag: 2030feb6-03a1-4aad-b4d4-1a146b8873e9

