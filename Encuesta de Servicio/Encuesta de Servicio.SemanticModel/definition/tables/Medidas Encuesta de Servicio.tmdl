	measure Card_neto_uss = ```
			
			// 1. Valores de cumplimiento (ámbito de la card)
			VAR valor     = [% Cumpl. Meta Evaluación]
			VAR variacion = BLANK() // Reemplazar por medida YoY si existe
			
			// 2. Número grande
			VAR vtxt =
			    IF(
			        ISBLANK(valor), 
			        "—", 
			        FORMAT(valor, "0.0%")
			    )
			
			// 3. Chip de variación interanual (verde sube / rojo baja)
			VAR hay    = NOT ISBLANK(variacion)
			VAR colV   = IF(variacion > 0, "#007350", IF(variacion < 0, "#B00020", "#49535F"))
			VAR bgC    = IF(variacion > 0, "#E1F9EE", IF(variacion < 0, "#FFEAEA", "#EEF2F7"))
			VAR vartxt = IF(variacion > 0, "+", "") & FORMAT(variacion, "0.0%")
			VAR chip   = IF(hay, "<span class='chip' style='background:" & bgC & ";color:" & colV & "'>" & vartxt & "</span>", "")
			VAR justif = IF(hay, "space-between", "center")
			
			// 4. Estilos y HTML final
			VAR estilos =
			    "<style>html,body{margin:0!important;padding:0!important;width:100%;height:100%;overflow:hidden!important;}#_c{box-sizing:border-box;width:100%;height:100vh;display:flex;flex-direction:column;border-left:4px solid #C6B27F;border-radius:9px 0 0 9px;padding:12px 18px 12px 20px;background:#FFFFFF;font-family:Arial;}#_h{flex:0 0 64px;min-height:64px;}#_t{font-size:14px;font-weight:700;line-height:1.2;color:#112B42;}#_s{margin-top:4px;font-size:12px;font-weight:400;line-height:1.18;color:#58616E;}#_values{flex:1;min-height:0;display:flex;flex-direction:column;justify-content:center;}.num{font-size:clamp(26px,11.5vw,34px);font-weight:700;line-height:1.1;color:#112B42;white-space:nowrap;}.chip{padding:0.28em 0.85em;border-radius:1000px;font-size:clamp(12px,3.4vw,14px);font-weight:700;line-height:1.4;white-space:nowrap;}</style>"
			RETURN
			    estilos &
			    "<div id='_c'><div id='_h'><div id='_t'>Neto de evaluación</div><div id='_s'>(votos 4+5 menos 1+2) / respuestas 1 a 5</div></div><div id='_values'><div style='display:flex;align-items:center;gap:0.6em;flex-wrap:wrap;justify-content:" & justif & ";'><span class='num'>" & vtxt & "</span>" & chip & "</div></div></div>"
			```
		displayFolder: 91 UI
		lineageTag: 231a411e-a80d-4607-b883-93cc66b729ed

	measure Card_satisfaccion = ```
			
			// 1. Valores de cumplimiento (ámbito de la card)
			VAR valor     = [% Satisfacción]
