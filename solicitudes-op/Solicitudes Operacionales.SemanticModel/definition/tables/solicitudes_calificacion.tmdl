	column start_datetime =
			VAR epoch_ms = [start_date]
			RETURN
				IF (
					ISBLANK ( epoch_ms ),
					BLANK (),
					DATE ( 1970, 1, 1 ) + DIVIDE ( epoch_ms, 86400000 )
				)
		dataType: dateTime
		formatString: General Date
		lineageTag: bab5d1ac-3be4-4fa5-9a60-b2c820fa2cdd
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column stop_datetime =
			VAR epoch_ms = [stop_date]
			RETURN
				IF (
					ISBLANK ( epoch_ms ),
					BLANK (),
					DATE ( 1970, 1, 1 ) + DIVIDE ( epoch_ms, 86400000 )
				)
		dataType: dateTime
		formatString: General Date
		lineageTag: 6718aa45-966e-459b-a83e-6e12cfc644cf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

